{
  "$schema": "vscode://schemas/color-theme",
  "name": "Lantern Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#040D23",
    "editor.foreground": "#F6F8F9",
    "editorLineNumber.foreground": "#8B94AD"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8B94AD", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#FF8A65" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#8BD5CA" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#F6C177" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#82AAFF" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class"], "settings": { "foreground": "#C4A7E7" } },
    { "scope": ["variable", "variable.other", "meta.object-literal.key", "support.variable.property"], "settings": { "foreground": "#F6F8F9" } },
    { "scope": ["variable.parameter", "meta.parameters variable"], "settings": { "foreground": "#F6C177", "fontStyle": "italic" } },
    { "scope": ["entity.other.attribute-name", "support.type.property-name", "variable.other.property"], "settings": { "foreground": "#7DCFFF" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#FF8A65" } },
    { "scope": ["markup.heading", "markup.heading entity.name"], "settings": { "foreground": "#82AAFF", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#8BD5CA" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#8B94AD" } }
  ],
  "semanticTokenColors": {
    "namespace": "#C4A7E7",
    "type": "#C4A7E7",
    "class": "#C4A7E7",
    "enum": "#C4A7E7",
    "interface": "#C4A7E7",
    "typeParameter": "#C4A7E7",
    "function": "#82AAFF",
    "method": "#82AAFF",
    "property": "#7DCFFF",
    "enumMember": "#F6C177",
    "variable": "#F6F8F9",
    "variable.readonly": "#F6C177",
    "variable.defaultLibrary": "#8BD5CA",
    "parameter": { "foreground": "#F6C177", "fontStyle": "italic" },
    "keyword": "#FF8A65",
    "string": "#8BD5CA",
    "number": "#F6C177",
    "regexp": "#8BD5CA",
    "operator": "#89DDFF",
    "decorator": "#F6C177",
    "*.declaration": { "bold": true },
    "*.deprecated": { "strikethrough": true },
    "*.documentation": { "fontStyle": "" },
    "*.abstract": { "italic": false },
    "variable:typescript": "#E2E8F0"
  }
}
