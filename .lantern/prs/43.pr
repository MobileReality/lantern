lantern-pr 1
# 43
#title feat: install the lantern command on Linux and Windows
#url https://github.com/MobileReality/lantern/pull/43
#branch feat/cli-install-win-linux
#base main
#opened 2026-11-12
#head 4d3f4de7ee143003d22993dcdf1b11383d92d14f
#describe what Settings, Command line installs a working lantern command on Linux and Windows too: a link in ~/.local/bin on Linux, a lantern.cmd shim and a user PATH entry on Windows, no admin rights.
#describe before The command could be installed on macOS only; the panel said so.
#describe after Linux and Windows get the command, with a PATH hint on Linux and a new-terminal note on Windows; macOS is unchanged.
#describe verified typecheck, lint and the full test run are green; the per-platform tests fail under their mutations. Nothing was run on Windows or Linux.
+ .gitattributes
+ src/cli/lantern.cmd
+ src/main/cli-user-install.ts
+ src/main/cli-user-port.ts
+ test/cli-user-install.test.ts
~ docs/installation.md
~ src/cli/lantern
~ src/main/cli.ts
~ src/main/main.ts
~ src/renderer/features/cli-panel.ts
~ test/cli-panel.test.ts
~ test/cli-script.test.ts
~ test/settings-dialog.test.ts
#order src/main/cli-user-install.ts
#order src/main/cli-user-port.ts
#order src/main/cli.ts
#order src/main/main.ts
#order src/cli/lantern
#order src/cli/lantern.cmd
#order .gitattributes
#order src/renderer/features/cli-panel.ts
